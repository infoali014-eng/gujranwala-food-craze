# Backend Environment Variables (Vercel Backend Project)

# Server Port (used for local development)
PORT=5000

# Environment mode (development | production)
NODE_ENV=development

# Frontend Origins (comma-separated list of allowed frontend URLs, no trailing slash)
FRONTEND_ORIGIN=http://localhost:3000,https://your-frontend-project.vercel.app

# Set to true to allow Vercel preview deployment URLs (*.vercel.app)
ALLOW_VERCEL_PREVIEWS=true

# Supabase Project URL (from Supabase Dashboard > Settings > API > Project URL)
SUPABASE_URL=https://your-project.supabase.co

# Supabase Service Role Secret Key (from Supabase Dashboard > Settings > API > service_role secret)
# CAUTION: Keep secret, never expose to frontend
SUPABASE_SERVICE_ROLE_KEY=eyJh...your-supabase-service-role-key
